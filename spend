#!/usr/bin/env bash
set -euo pipefail

if ! command -v gcloud >/dev/null 2>&1; then
  echo "Missing required command: gcloud" >&2
  exit 1
fi

PROJECT_ID="${GOOGLE_CLOUD_PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
SERVICE="${SERVICE_NAME:-medicare-stars-agent}"
FRESHNESS="${FRESHNESS:-7d}"
LIMIT="${LIMIT:-25}"

if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "(unset)" ]]; then
  echo "No active Google Cloud project." >&2
  exit 1
fi

echo "Recent per-invocation LLM list-price estimates"
echo "Project: $PROJECT_ID | Service: $SERVICE | Window: $FRESHNESS"
echo

gcloud logging read \
  "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND jsonPayload.event=\"llm_usage_estimate\"" \
  --project="$PROJECT_ID" \
  --freshness="$FRESHNESS" \
  --limit="$LIMIT" \
  --order=desc \
  --format='table(timestamp:label=TIME,jsonPayload.invocation_id:label=INVOCATION,jsonPayload.model:label=MODEL,jsonPayload.model_calls:label=CALLS,jsonPayload.input_tokens:label=INPUT,jsonPayload.billable_output_tokens:label=OUTPUT,jsonPayload.total_tokens:label=TOTAL,jsonPayload.estimated_cost_usd:label=EST_USD,jsonPayload.pricing_version:label=PRICING)'

echo
echo "Estimates use the versioned rates deployed with the service."
echo "Google Cloud Billing is authoritative for actual charges and credits."
