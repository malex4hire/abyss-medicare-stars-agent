#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ "${1:-}" == "--local" ]]; then
  python3 run_local.py
  exit 0
fi

for command_name in python3 gcloud bq; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
done

PROJECT_ID="${GOOGLE_CLOUD_PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "(unset)" ]]; then
  echo "Set a project first: gcloud config set project abyss-stars-agent-926" >&2
  exit 1
fi

export GOOGLE_CLOUD_PROJECT="$PROJECT_ID"
export GOOGLE_CLOUD_LOCATION="${GOOGLE_CLOUD_LOCATION:-us-east4}"
export GOOGLE_GENAI_USE_VERTEXAI="true"

if [[ ! -x .venv/bin/python ]]; then
  python3 -m venv .venv
fi
.venv/bin/python -m pip install --disable-pip-version-check -q -r requirements.txt

if ! bq show --project_id="$PROJECT_ID" medicare_stars_demo.member_experience >/dev/null 2>&1; then
  scripts/bootstrap_gcp.sh
fi

echo "Running Google ADK -> Vertex AI -> MCP -> BigQuery"
echo "Project: $PROJECT_ID"
echo
.venv/bin/python run_agent.py "${*:-}"

